# Normalise text to LF in the repo
* text=auto eol=lf

# Source
*.py    text diff=python
*.md    text diff=markdown
*.html  text diff=html

# Generated by cad/export.py: keep them out of diffs and language stats
fab/cut/*.svg  -diff linguist-generated

# CAD / fabrication files: never touch line endings, never diff or merge
*.step filter=lfs diff=lfs merge=lfs -text
*.stp  filter=lfs diff=lfs merge=lfs -text
*.stl  binary
*.3mf  binary
*.dxf  binary

# Images and documents
*.png  binary
*.jpg  binary
*.jpeg binary
*.pdf  binary
